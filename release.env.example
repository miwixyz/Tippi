# Copy this file to release.env and fill in your values.
# release.env is gitignored — never commit your signing identity name to the repo.

# Your Developer ID Application certificate, formatted exactly as in Keychain Access.
# Find it with: security find-identity -v -p codesigning
DEVELOPER_ID="Developer ID Application: Your Name (YOUR_TEAM_ID)"

# Notarytool keychain profile name (set up once with `xcrun notarytool store-credentials`)
NOTARY_PROFILE="tippi-notary"

# Note: VERSION lives in project.yml (MARKETING_VERSION) only.
# Bump via: ./scripts/bump-version.sh X.Y.Z — do NOT add VERSION here.
