<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.dev.mwlr.Tippi</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.dev.mwlr.Tippi</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>LTKJ6Z2VYB.*</string>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Debug-only, opposite of Tippi.entitlements: `true` here, not `false`.
	     Root-caused 2026-09-15 (/diagnose): commit 038b634 (2026-05-12) set
	     get-task-allow=false for notarization, correctly, but the project
	     used ONE entitlements file for every configuration — so Debug builds
	     inherited it too. `testmanagerd` needs task_for_pid on the unit-test
	     host to drive it; with the entitlement denying that, the wait never
	     times out, so `xcodebuild test` hangs forever instead of failing.
	     Confirmed by ad-hoc-resigning a built Debug app with this flipped to
	     `true`: the hang became a normal few-second pass/fail. Release/notarized
	     builds must still use Tippi.entitlements with `false` — Developer ID
	     signing requires it. -->
	<key>com.apple.security.get-task-allow</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
